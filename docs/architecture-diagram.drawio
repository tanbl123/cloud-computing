        <mxCell id="s3backups" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;asm-db-backups-&amp;lt;account-id&amp;gt;&lt;br&gt;versioned mysqldump backups&lt;br&gt;lifecycle: Glacier @7d, delete @30d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#0073BB;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1190" y="578" width="215" height="86" as="geometry" />
