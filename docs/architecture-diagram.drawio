        </mxCell>
        <mxCell id="pubB" value="Public subnet  asm-Public-B  ·  10.0.1.0/24&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;route table asm-RT-Public → 0.0.0.0/0 via asm-IGW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7EE;strokeColor=#7AA116;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#5C7A10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="280" width="400" height="196" as="geometry" />
        </mxCell>

        <mxCell id="alb" value="&lt;b&gt;asm-ALB · Application Load Balancer (internet-facing)&lt;/b&gt;&lt;br&gt;HTTP:80 listener → target group App-TG · health check / · both AZs · ALB-SG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11.5;fontColor=#8C4FFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="810" height="56" as="geometry" />
        </mxCell>

        <mxCell id="nat" value="&lt;b&gt;asm-NAT&lt;/b&gt;&lt;br&gt;NAT gateway&lt;br&gt;EIP 52.73.159.122" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cloud9" value="&lt;b&gt;asm-Cloud9&lt;/b&gt;&lt;br&gt;t3.micro · SSH&lt;br&gt;admin + load testing + backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF4EC;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="496" y="400" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="albnote" value="(load balancer node only)" style="text;html=1;fontSize=10;fontColor=#7A8A5A;align=center;" vertex="1" parent="1">
          <mxGeometry x="852" y="418" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- App tier -->
        <mxCell id="appA" value="Private subnet  asm-App-A  ·  10.0.2.0/24&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;route table asm-RT-App → 0.0.0.0/0 via asm-NAT (outbound only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF4EC;strokeColor=#ED7100;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#B35700;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="278" y="502" width="400" height="280" as="geometry" />
        </mxCell>
        <mxCell id="appB" value="Private subnet  asm-App-B  ·  10.0.3.0/24&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;route table asm-RT-App → 0.0.0.0/0 via asm-NAT (outbound only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF4EC;strokeColor=#ED7100;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#B35700;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="502" width="400" height="280" as="geometry" />
        </mxCell>

        <mxCell id="asg" value="Auto Scaling group  App-ASG  ·  min 2 / desired 2 / max 4&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;App-LT-v1 · App-Server-AMI-v1 · target tracking CPU 50% · warm-up 300s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;dashed=1;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#B35700;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="556" width="810" height="122" as="geometry" />
        </mxCell>
        <mxCell id="ec2a" value="&lt;b&gt;EC2 t3.micro&lt;/b&gt;&lt;br&gt;Node.js app · port 80&lt;br&gt;App-SG · LabInstanceProfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="606" width="150" height="58" as="geometry" />
        </mxCell>
        <mxCell id="ec2b" value="&lt;b&gt;EC2 t3.micro&lt;/b&gt;&lt;br&gt;Node.js app · port 80&lt;br&gt;App-SG · LabInstanceProfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="784" y="606" width="150" height="58" as="geometry" />
        </mxCell>

        <mxCell id="dataserver" value="&lt;b&gt;Data-Server · EC2 t3.micro (stage 20)&lt;/b&gt;&lt;br&gt;Data-SG accepts App-SG only · LabInstanceProfile · Session Manager, no SSH&lt;br&gt;socat forwards TCP 3306 → asm-rds, run as systemd db-forward.service&lt;br&gt;&lt;font color=&quot;#C7442E&quot;&gt;standalone instance, not in App-ASG — no automatic self-healing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="700" width="356" height="74" as="geometry" />
        </mxCell>
        <mxCell id="nodataserver" value="&lt;b&gt;no Data-Server in this AZ&lt;/b&gt;&lt;br&gt;single instance — limitation noted below&lt;br&gt;both AZs' app instances reach it via Data-SG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;dashed=1;strokeWidth=1.4;fontSize=10;fontColor=#5F9188;align=center;" vertex="1" parent="1">
          <mxGeometry x="754" y="700" width="356" height="74" as="geometry" />
        </mxCell>

        <!-- DB tier -->
        <mxCell id="dbA" value="Private subnet  asm-DB-A  ·  10.0.4.0/24&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;route table asm-RT-DB — local route only, no path to the internet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7F5;strokeColor=#01A88D;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#017A66;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="278" y="808" width="400" height="280" as="geometry" />
        </mxCell>
        <mxCell id="dbB" value="Private subnet  asm-DB-B  ·  10.0.5.0/24&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;route table asm-RT-DB — local route only, no path to the internet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7F5;strokeColor=#01A88D;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#017A66;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="808" width="400" height="280" as="geometry" />
        </mxCell>

        <mxCell id="rdsprimary" value="&lt;b&gt;asm-rds · Amazon RDS for MySQL&lt;/b&gt;&lt;br&gt;db.t3.micro · 20 GiB gp3 · Single-AZ · Publicly accessible: No&lt;br&gt;database STUDENTS · 7-day backups · DB-SG&lt;br&gt;&lt;font color=&quot;#C7442E&quot;&gt;DB-SG now accepts Data-SG only, not App-SG directly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="862" width="356" height="78" as="geometry" />
        </mxCell>
        <mxCell id="rdsreplica" value="&lt;b&gt;asm-rds-replica · Read Replica (stage 21)&lt;/b&gt;&lt;br&gt;db.t3.micro · Single-AZ · same region as asm-rds&lt;br&gt;read scaling — targets stage 16's DB-tier bottleneck finding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=1.6;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="960" width="356" height="78" as="geometry" />
        </mxCell>
        <mxCell id="nordsb" value="&lt;b&gt;no RDS instance in this AZ&lt;/b&gt;&lt;br&gt;primary and replica both sit in asm-DB-A&lt;br&gt;subnet exists because RDS requires a DB subnet&lt;br&gt;group spanning two Availability Zones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;dashed=1;strokeWidth=1.4;fontSize=10;fontColor=#5F9188;align=center;" vertex="1" parent="1">
          <mxGeometry x="754" y="862" width="356" height="166" as="geometry" />
        </mxCell>

        <mxCell id="dbsubnetgroup" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#01A88D;dashed=1;strokeWidth=1.2;verticalAlign=bottom;fontSize=10.5;fontColor=#017A66;" vertex="1" parent="1">
          <mxGeometry x="288" y="852" width="832" height="192" as="geometry" />
        </mxCell>
        <mxCell id="dbsubnetgrouplabel" value="DB subnet group  asm-db-subnet-group  (spans us-east-1a and us-east-1b)" style="text;html=1;fontSize=10.5;fontColor=#017A66;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="1050" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;How the requirements are met&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Highly available&lt;/b&gt;&lt;br&gt;Every tier in two AZs; ALB health checks replace failed instances automatically&lt;br&gt;&lt;br&gt;&lt;b&gt;Scalable&lt;/b&gt;&lt;br&gt;Target tracking adds capacity as average CPU rises past 50%&lt;br&gt;&lt;br&gt;&lt;b&gt;Secure&lt;/b&gt;&lt;br&gt;Database has no internet route; each tier accepts only the tier in front of it; no stored password&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost optimised&lt;/b&gt;&lt;br&gt;Burstable instances, one NAT, ASG minimum set for resilience&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#01A88D&quot;&gt;Additional features (5 marks)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;19: S3 backup versioning + lifecycle&lt;br&gt;20: Data-Server middle tier (proxy)&lt;br&gt;21: asm-rds-replica (read scaling)&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#C7442E&quot;&gt;Known limitations&lt;/font&gt;&lt;/b&gt;&lt;br&gt;RDS single-AZ (replica does not remove this — Multi-AZ blocked in this Lab, first prod. upgrade)&lt;br&gt;Data-Server has no ASG-style self-healing if it stops — fixed socat's persistence with systemd, but restart is still manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C7CDD3;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="196" height="470" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Build-SG, the temporary group used to reach instances during construction, was deleted after the build and is not part of the delivered architecture. SNS scaling notifications (stage 18) omitted — lecturer ruled it too simple to count, kept as a bonus not shown here." style="text;html=1;fontSize=9.5;fontColor=#8A94A0;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="1160" width="1400" height="30" as="geometry" />
        </mxCell>

