        <mxCell id="igw" value="&lt;b&gt;asm-IGW&lt;/b&gt;&lt;br&gt;Internet gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=10.5;align=center;" vertex="1" parent="1">
