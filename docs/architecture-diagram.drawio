          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="TCP 3306 · Data-SG accepts App-SG only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;fontSize=9.5;fontColor=#017A66;" edge="1" parent="1" source="ec2a" target="dataserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;" edge="1" parent="1" source="ec2b" target="dataserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="TCP 3306 (socat forward) · DB-SG accepts Data-SG only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;fontSize=9.5;fontColor=#017A66;" edge="1" parent="1" source="dataserver" target="rdsprimary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="asynchronous replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2.4;fontSize=9.5;fontColor=#017A66;" edge="1" parent="1" source="rdsprimary" target="rdsreplica">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;dashed=0;" edge="1" parent="1" source="ec2a" target="nat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;" edge="1" parent="1" source="nat" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="GetSecretValue via LabRole — no credential stored on the instance or in the AMI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=9.5;fontColor=#ED7100;" edge="1" parent="1" source="igw" target="secretsmgr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="3306 · migration / admin queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A94A0;strokeWidth=1.6;dashed=1;fontSize=9.5;fontColor=#8A94A0;" edge="1" parent="1" source="cloud9" target="rdsprimary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="mysqldump backup upload (stage 19)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0073BB;strokeWidth=1.8;dashed=1;fontSize=9.5;fontColor=#0073BB;" edge="1" parent="1" source="cloud9" target="s3backups">
          <mxGeometry relative="1" as="geometry" />
