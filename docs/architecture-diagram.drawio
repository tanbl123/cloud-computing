        <!-- AZ columns -->
        <mxCell id="azA" value="Availability Zone  us-east-1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0073BB;dashed=1;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#0073BB;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
