        <!-- Public tier -->
        <mxCell id="pubA" value="Public subnet  asm-Public-A  ·  10.0.0.0/24&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;route table asm-RT-Public → 0.0.0.0/0 via asm-IGW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7EE;strokeColor=#7AA116;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#5C7A10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
