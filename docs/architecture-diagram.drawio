          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="scaling + ReplicaLag metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#759C3E;strokeWidth=1.8;fontSize=9.5;fontColor=#759C3E;" edge="1" parent="1" source="asg" target="cloudwatch">
